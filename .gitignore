# Dependencias instaladas (no se suben node_modules)
node_modules/

# Archivos de logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Directorio de producción o builds (si aplicara)
dist/
build/

# Archivos de sistema OS
.DS_Store
Thumbs.db

# Variables de entorno (archivo con datos sensibles)
.env

# Carpetas o archivos específicos del editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Archivos temporales
*.tmp
*.temp

# Coverage (informes de cobertura de tests)
coverage/

# Otros archivos temporales o caches
.cache/